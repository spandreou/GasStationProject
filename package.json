{
  "name": "gas-station-shift-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "qa:scheduler-engine": "node scripts/stress-test-scheduler-engine.mjs",
    "qa:scheduler": "node scripts/validate-scheduler-rules.mjs && npm run build",
    "qa:repositories": "node scripts/validate-repository-boundaries.mjs",
    "test:e2e:scheduler": "playwright test tests/scheduler-roles.e2e.spec.js",
    "preview": "vite preview",
    "security:audit": "npm audit --audit-level=high",
    "admin:bootstrap": "node scripts/bootstrap-admin-user.mjs",
    "deploy:firestore-rules": "npx --yes firebase-tools deploy --only firestore:rules",
    "deploy:storage-rules": "npx --yes firebase-tools deploy --only storage",
    "deploy:firebase-rules": "npx --yes firebase-tools deploy --only firestore:rules,storage",
    "security:cve": "npx --yes cve-lite-cli@1 . --all --verbose --fail-on high",
    "security:integrity": "node scripts/validate-firestore-integrity.mjs",
    "security:hardening": "node scripts/validate-security-hardening.mjs",
    "security:scan": "npm run security:hardening && npm run security:integrity && npm run security:audit && npm run security:cve"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.2.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e965/xlsx": "^0.20.3",
    "docx": "^9.5.1",
    "firebase": "^11.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.511.0",
    "postprocessing": "^6.37.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.175.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.2"
  }
}
