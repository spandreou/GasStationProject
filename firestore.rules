rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminByClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // DEMO-only fallback until production hardening enables strict custom-claims flow.
    function isAdminByEmail() {
      return isSignedIn() && request.auth.token.email in ['admin@example.com'];
    }

    function isAdmin() {
      return isAdminByClaim() || isAdminByEmail();
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shifts/{shiftId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /shiftTemplates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /attendance_history/{historyId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /week_locks/{weekId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /week_history/{historyId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /week_templates/{templateId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
