rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isTenantAdminRole(role) {
      return role in ['OWNER', 'ADMIN', 'MANAGER'];
    }

    function isTenantAdmin(tenantId) {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)) &&
        firestore.get(/databases/(default)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.uid == request.auth.uid &&
        firestore.get(/databases/(default)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.tenantId == tenantId &&
        firestore.get(/databases/(default)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.status == 'ACTIVE' &&
        isTenantAdminRole(firestore.get(/databases/(default)/documents/tenantMemberships/$(request.auth.uid + '_' + tenantId)).data.role);
    }

    function isArchiveFile(tenantId, yearMonth, fileName) {
      return tenantId.matches('^[a-z0-9-]{1,60}$') &&
        yearMonth.matches('^\\d{4}-\\d{2}$') &&
        fileName == 'program_month_' + yearMonth + '.pdf';
    }

    match /tenants/{tenantId}/monthly_schedule_pdfs/{yearMonth}/{fileName} {
      allow read: if isTenantAdmin(tenantId) && isArchiveFile(tenantId, yearMonth, fileName);
      allow write: if isTenantAdmin(tenantId) &&
        isArchiveFile(tenantId, yearMonth, fileName) &&
        request.resource != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'application/pdf';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
